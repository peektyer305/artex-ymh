# ARTEX systemd unit —— クラッシュ時の自動再起動 + 起動時の自動起動
#
# インストール（または install.sh の systemd 分岐で自動実行）：
#   sudo install -m644 packaging/artex.service /etc/systemd/system/artex.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now artex
#
# start.sh との関係：
#   systemd モードでは【start.sh を重ねて使わない】—— 監視の役割（クラッシュ再起動、バックオフ、起動時自動起動）
#   は systemd に移譲済みで、 ExecStart は artex 本体を直接実行します。画面の「ワンクリック更新」の入れ替え処理
#   は影響を受けません： artex の終了コード 75（自己更新/ロールバック準備完了）は非ゼロ終了であり、 Restart=on-failure
#   が再起動します。新しいバイナリは artex 自身が起動時に検証/入れ替えします（selfupdate パッケージ）。
#   終了コード 0（ユーザーの正常停止 / systemctl stop）は正常終了とみなし、再起動しません。
#   start.sh / start.bat は systemd のない環境（macOS、Windows、Docker ENTRYPOINT）向けに残しています。
[Unit]
Description=ARTEX agentic pentest platform
Documentation=https://github.com/Autumn-27/ARTEX
# 弱依存：ネットワーク/Postgres があれば先に待ち、なくても起動を妨げません（DB は別マシンに置けます）
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
# プロセス異常が上限に達した場合の保険：60s 以内に最大 5 回まで再起動し、超えたら failed 状態で手動対応
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# 実行アカウント：デフォルトは artex（存在しない場合は先に useradd -r -s /usr/sbin/nologin artex を実行するか、
# 自身のデプロイアカウントに変更してください。 install.sh はインストール実行者に自動で置き換えます）
User=artex
# インストールディレクトリ（artex バイナリ、config.json、skills/、data/ を含む）。install.sh が実際のパスに置き換えます
WorkingDirectory=/opt/artex
# 任意の環境変数注入：ファイルがなくてもエラーにしません（行頭の -）。ARTEX_CALLBACK_ADDR
# （リバースシェル/トンネルの戻り接続先）など、config.json に書きにくい環境変数に使用
EnvironmentFile=-/etc/artex.env
ExecStart=/opt/artex/artex -addr :8787 -proxy :8788
# クラッシュ/自己更新時の再起動：固定 5s 間隔（systemd に指数バックオフの内蔵なし。v254+ では
#   RestartSteps=4 / RestartMaxDelaySec=60s で 5→60s の段階的増加（上限まで）に変更可能）
Restart=on-failure
RestartSec=5s
# メモリ上限は必要に応じて有効化（デフォルトでは未設定）。探索タスクでメモリを消費する場合に推奨：
# MemoryMax=2G
# トラフィック記録は大量の接続を開きます
LimitNOFILE=65535
# ログは journal へ： journalctl -u artex -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=artex

[Install]
WantedBy=multi-user.target
