# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# Documentation sources are tracked; only generated documentation is ignored.
/docs/_build/
/docs/.cache/

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# フロントエンドを埋め込んだ単一バイナリの生成物
/artex
# ワンクリック更新が実行ファイルの隣に残す中間生成物（一時ファイル / バックアップ / 失敗版 / アップグレードマーカー）
/server/webui/dist/
/dist/

# JWT 署名鍵（実行時に生成され、プロジェクトルートに保存される。絶対にコミットしない）
/jwt.key

# Docker デプロイで生成されるローカル環境設定（パスワード/鍵を含むためコミットしない）
.env

# スケジューラの実行/シミュレーションで生成されるイベントログ（テスト生成物のためコミットしない）
*-events.csv

# bench ベンチマーク関連（ローカル生成物のためコミットしない）
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
