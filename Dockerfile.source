# syntax=docker/dockerfile:1
#
# ソースから全量ビルドするイメージ（自己完結、ビルド済みバイナリ不要）：フロントエンドビルド → Go コンパイル → ランタイム。
# ルートの Dockerfile との関係：あちらは「ビルド済みバイナリ + ツール層」のパッケージ用イメージ（CI 用）、
# こちらはユーザーが docker compose build でソースから一発でイメージを作るためのもの。最終的なツール層は両者で同一。
#
# ビルド（中国国内のネットワークでは、Docker にプロキシを設定するかミラーサイトへの切り替えを推奨）：
#   docker compose build    # compose は本ファイルを参照済み

# ---------- ① フロントエンドの静的エクスポート ----------
FROM node:22-alpine AS fe
# 任意のビルド引数：中国国内ビルド用のミラー、デフォルトは公式ソース
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm config set registry "$NPM_REGISTRY" && npm ci
COPY web/ ./
RUN npm run build:static

# ---------- ② Go コンパイル（フロントエンドを埋め込み） ----------
FROM golang:1.26-alpine AS gobuild
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN mkdir -p server/webui/dist
COPY --from=fe /src/web/out/ server/webui/dist/
# CGO_ENABLED=0 の純静的成果物。alpine（musl）でビルドしたバイナリは bookworm のランタイムでも動作する
RUN CGO_ENABLED=0 go build -tags embedui -trimpath -ldflags "-s -w" -o /out/artex ./cmd/artex

# ---------- ③ ランタイム（Dockerfile のツール層と一致） ----------
FROM python:3.12-slim-bookworm
# 任意のビルド引数：APT ミラー（デフォルトは公式 deb.debian.org、中国国内では mirrors.aliyun.com または mirrors.ustc.edu.cn を指定可能）
ARG APT_MIRROR=
ARG NPM_REGISTRY=https://registry.npmjs.org
# Node のインストール元：デフォルトは nodejs.org の公式 tarball、中国国内では https://registry.npmmirror.com/-/binary/node を指定可能
# （NodeSource の可変スクリプト方式は廃止——第三者のスクリプトをパイプ実行する方式で中国国内から到達できないため。公式 tarball + SHASUMS256 検証に変更）
ARG NODE_DIST_BASE=https://nodejs.org/dist
ARG NODE_VERSION=22.14.0
# Playwright ブラウザのダウンロード元：デフォルトは公式 CDN、中国国内では https://registry.npmmirror.com/-/binary/playwright を指定可能
ARG PLAYWRIGHT_DOWNLOAD_HOST=
# レイヤーの注意点：各層は独立した RUN であり、ある層が失敗して再試行しても前の層はキャッシュを利用できる
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      build-essential \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && rm -rf /var/lib/apt/lists/*
# Node：公式 tarball + 同一配布元の SHASUMS256 検証（fail-closed。検証ファイル内の相対パスは
# CWD 基準で解決されるため、すべて /tmp にダウンロードして /tmp 配下で検証する。.tar.gz 版を使う——slim ベース
# イメージには xz-utils が入っていないため）
RUN set -e; \
    cd /tmp; \
    curl -fsSL -o "node-v${NODE_VERSION}-linux-x64.tar.gz" "${NODE_DIST_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz"; \
    curl -fsSL "${NODE_DIST_BASE}/v${NODE_VERSION}/SHASUMS256.txt" \
      | grep "node-v${NODE_VERSION}-linux-x64.tar.gz" | sha256sum -c -; \
    tar -xzf "node-v${NODE_VERSION}-linux-x64.tar.gz" -C /usr/local --strip-components=1; \
    rm -f "node-v${NODE_VERSION}-linux-x64.tar.gz"
# Playwright MCP/CLI + chromium（--with-deps の内部でも apt を実行するが、APT_MIRROR は有効）
RUN npm config set registry "$NPM_REGISTRY" \
    && npm install -g @playwright/mcp@0.0.80 @playwright/cli@0.1.19 playwright@1.63.0 \
    && playwright-cli --help \
    && if [ -n "$PLAYWRIGHT_DOWNLOAD_HOST" ]; then \
         PLAYWRIGHT_DOWNLOAD_HOST="$PLAYWRIGHT_DOWNLOAD_HOST" playwright install --with-deps chromium; \
       else \
         playwright install --with-deps chromium; \
       fi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=gobuild /out/artex /app/artex
COPY start.sh /app/start.sh
RUN chmod +x /app/artex /app/start.sh
COPY skills/ /app/skills/
COPY packaging/tools-manifest.json /app/packaging/tools-manifest.json
ENV ARTEX_TOOLS_MANIFEST=/app/packaging/tools-manifest.json
VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
