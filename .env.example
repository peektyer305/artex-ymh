# Docker デプロイ設定（.env にコピーして使用）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（どちらか一方、または両方を指定。空のまま UI で設定しても可）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# プラットフォームへのコールバックアドレス：リバースシェル／トンネル（イントラネット侵入フェーズ 3/5）がプラットフォームへ接続する際に使用。フェーズ 1a（WebShell フットホールド）では不要
# ARTEX_CALLBACK_ADDR=10.0.0.5:443

# 多段プロキシトンネル（イントラネット侵入フェーズ 3a）：chisel バイナリのパス（デフォルト data/tools/chisel。ターゲットと同一プラットフォームの linux/amd64 版が必要）
# ARTEX_CHISEL_PATH=/opt/artex/tools/chisel

# リバースシェルハンドラ（イントラネット侵入フェーズ 5）：penelope.py のパス（デフォルト data/tools/penelope.py）と python インタプリタ
# ARTEX_PENELOPE_PATH=/usr/local/bin/penelope.py
# ARTEX_PENELOPE_PYTHON=python3

# トンネルポートプール：プラットフォーム側 chisel server の待受ポートと socks／転送入口はいずれもこのプールから割り当て（デフォルト 20000-21000）
# ARTEX_TUNNEL_PORT_RANGE=20000-21000

# タスク単位の MITM（フェーズ 3b）：worker のトラフィックはタスク専用の録画インスタンス → タスクトンネルの socks → イントラネット、と経由し、証跡の連鎖を切らさない。
# デフォルトはオン。off で無効化（worker はグローバル記録プロキシへフォールバック）。インスタンスのポートプールはデフォルト 21100-21199 で、トンネルプールと重ならない。
# ARTEX_TASK_PROXY=off
# ARTEX_TASK_PROXY_PORT_RANGE=21100-21199
